# Optional. `docker compose up -d --build` works without this file.
# Copy it to .env and change what you need.

# Claude. Without a key the site still works: every reply waits in the
# author's queue instead of being checked by the moderator agent.
ANTHROPIC_API_KEY=
# Models. claude-haiku-4-5 is the cheapest and fastest ($1 in / $5 out per million tokens).
# If the summaries feel thin, give the note-taker alone a bigger one, e.g. claude-sonnet-5-5.
CAFE_MODERATOR_MODEL=claude-haiku-4-5
CAFE_NOTETAKER_MODEL=claude-haiku-4-5

# Your login for http://localhost:8010/counter/ (created on first start).
DJANGO_SUPERUSER_USERNAME=house
DJANGO_SUPERUSER_PASSWORD=footballcafe
DJANGO_SUPERUSER_EMAIL=house@example.com

# Django
DJANGO_SECRET_KEY=dev-only-change-me
DEBUG=True
DEV=true
SEED_DEMO=true
# True only when the site is reached through an https address.
HTTPS=False
DJANGO_LOGLEVEL=info
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8010,http://127.0.0.1:8010

# Database
DATABASE_NAME=footballcafe
DATABASE_USERNAME=footballcafe
DATABASE_PASSWORD=footballcafe

# Ports on your machine
WEB_PORT=8010
# Only for a server with a domain. scripts/make_env.py --domain fills these in.
DOMAIN=
COMPOSE_PROFILES=
WEB_BIND=0.0.0.0
DATABASE_PUBLIC_PORT=5440
